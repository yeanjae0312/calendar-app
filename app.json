{
  "expo": {
    "name": "하루조각",
    "slug": "yeonjae-calendar",
    "scheme": "harujogak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yeonjae.calendar",
      "adaptiveIcon": {
        "backgroundColor": "#9ED6B8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#9ED6B8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DDay",
              "label": "디데이",
              "description": "첫 번째 디데이를 크게 보여 줘요",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Today",
              "label": "오늘 일정",
              "description": "오늘 일정을 시간 순서로 보여 줘요",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Stickers",
              "label": "이번 달 스티커",
              "description": "이번 달 하루 꾸미기 스티커를 달력으로 보여 줘요",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e75f6a3b-2cbc-4310-9cad-f4cfd7443662"
      }
    },
    "owner": "yeonjaelee"
  }
}
